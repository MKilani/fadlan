{
  "expo": {
    "name": "Fadlan",
    "slug": "fadlan",
    "version": "0.1.0",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "org.example.fadlan",
      "supportsTablet": false
    },
    "android": {
      "package": "org.example.fadlan"
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fadlan uses your position to show nearby places of interest on the map."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Fadlan",
      "shortName": "Fadlan",
      "themeColor": "#F1E7C8",
      "backgroundColor": "#F1E7C8",
      "display": "standalone"
    }
  }
}